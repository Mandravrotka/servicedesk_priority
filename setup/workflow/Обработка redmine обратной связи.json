      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  rl.priority_determined,\n  ll.input_text,\n  rl.domain_id\nFROM redmine_logs rl\nLEFT JOIN llm_logs ll ON rl.issue_id = ll.issue_id\nWHERE rl.issue_id = {{ $json.id }}\nORDER BY rl.logged_at DESC \nLIMIT 1;",
        "options": {}
